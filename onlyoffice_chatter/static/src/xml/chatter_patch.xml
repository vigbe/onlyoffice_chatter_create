<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

  <!-- ============================================================
       Diálogo OWL2: selector de formato y título del nuevo archivo
       ============================================================ -->
  <t t-name="onlyoffice_chatter.CreateDialog">
    <div>
      <Dialog
        title="this.dialogTitle"
        contentClass="'o-oo-chatter-create-dialog'"
      >
        <!-- Nombre del documento -->
        <div class="mb-3">
          <label class="o_form_label fw-bold" for="oo_chatter_title">
            <t t-out="this.labels.title"/>
          </label>
          <input
            class="o_input form-control mt-1"
            id="oo_chatter_title"
            t-model.trim="this.state.title"
            type="text"
            autocomplete="off"
            t-ref="this.titleInputRef"
            t-att-placeholder="this.labels.placeholder"
          />
        </div>

        <!-- Selector de formato -->
        <div class="d-flex gap-3 justify-content-center py-2">
          <t t-foreach="this.formats" t-as="fmt" t-key="fmt.ext">
            <div
              role="button"
              tabindex="0"
              class="o-oo-format-card d-flex flex-column align-items-center p-2 rounded cursor-pointer"
              t-att-class="this.state.selectedFormat === fmt.ext ? 'o-oo-format-selected border border-primary' : 'border border-transparent'"
              t-on-click="() => this.selectFormat(fmt.ext)"
              t-on-dblclick="() => this.createFile()"
              t-on-keydown="(ev) => this.handleFormatKeydown(fmt.ext, ev)"
            >
              <i
                t-if="fmt.ext === 'docx'"
                class="oi o-oo-format-icon mb-1"
                role="img"
                data-icon="description"
                t-att-aria-label="fmt.label"
              />
              <i
                t-if="fmt.ext === 'xlsx'"
                class="oi o-oo-format-icon mb-1"
                role="img"
                data-icon="table_chart"
                t-att-aria-label="fmt.label"
              />
              <i
                t-if="fmt.ext === 'pptx'"
                class="oi o-oo-format-icon mb-1"
                role="img"
                data-icon="slideshow"
                t-att-aria-label="fmt.label"
              />
              <span class="small text-muted" t-out="fmt.label"/>
            </div>
          </t>
        </div>

        <t t-set-slot="footer">
          <button
            class="btn btn-primary"
            t-att-disabled="this.isButtonDisabled()"
            t-on-click="() => this.createFile()"
          >
            <t t-if="this.state.isCreating">
              <span class="spinner-border spinner-border-sm me-1" role="status"/>
              <t t-out="this.labels.creating"/>
            </t>
            <t t-else="">
              <t t-out="this.labels.create"/>
            </t>
          </button>
          <button class="btn btn-secondary" t-on-click="() => this.props.close()">
            <t t-out="this.labels.cancel"/>
          </button>
        </t>
      </Dialog>
    </div>
  </t>

  <!-- ============================================================
       Herencia de mail.Chatter — inyecta el botón "Nuevo"
       (Odoo 20: expresiones con prefijo this. e iconos oi)
       ============================================================ -->
  <t t-name="onlyoffice_chatter.ChatterPatch"
     t-inherit="mail.Chatter"
     t-inherit-mode="extension">
    <xpath expr="//button[hasclass('o-mail-Chatter-activity')]" position="after">
      <button
        type="button"
        class="btn btn-secondary text-nowrap"
        t-att-title="this.ooLabels.buttonTitle"
        t-on-click="this.openOnlyofficeDialog"
      >
        <i class="oi oi-fw me-1" data-icon="note_add" aria-hidden="true"/>
        <t t-out="this.ooLabels.buttonText"/>
      </button>
    </xpath>
  </t>

</templates>
